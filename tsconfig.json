{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "src": ["./src/index.ts"],
      "src/*": ["./src/*"],
      "cli/*": ["./src/cli/*"],
      "types": ["./types/index.ts"],
      "types/*": ["./types/*"],
      "package": ["./package.json"],
      "@h3ravel/arquebus": ["./src/index.ts"],
      "@h3ravel/arquebus/browser": ["./src/browser/index.ts"],
      "@h3ravel/arquebus/inspector": ["./src/inspector/index.ts"]
    }
  },
  "include": ["./src", "./types", "./type-tests", "./*.ts"],
  "exclude": [
    "./bin",
    "./dist",
    "./**/dist",
    "./node_modules",
    "./src/inspector/tests"
  ]
}
